---
import "@/styles/globals.css";
import { Button } from "@/components/ui/button";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Simple TP</title>
    <style>
      #tp {
        font-size: 5rem;
        transform: scaleX(1);
      }

      #tp.reversed {
        transform: scaleX(-1);
      }
    </style>
  </head>
  <body>
    <div class="fixed w-full z-10 p-2 group">
      <div
        class="rounded-lg border bg-card text-card-foreground shadow-sm w-full p-2 flex justify-between items-center bg-white dark:bg-black dark:text-white opacity-0 group-hover:opacity-90"
      >
        <div class="flex gap-2 items-center">
          <Button data-slow-down><i data-lucide="minus"></i></Button>
          <Button data-speed-up><i data-lucide="plus"></i></Button>
          <Button data-reverse><i data-lucide="arrow-down-up"></i></Button>
          <Button data-invert><i data-lucide="flip-horizontal-2"></i></Button>
          <Button data-lock-toggle><i data-lucide="lock-open"></i></Button>
          <Button data-toggle-theme><i data-lucide="sun-moon"></i></Button>
        </div>
        <div>
          <Button data-toggle-play><i data-lucide="play"></i></Button>
        </div>
      </div>
    </div>
    <div
      id="tp"
      class="relative z-0 p-2 dark:bg-black dark:text-white"
      contenteditable
    >
      paste here <br /> HIT CTRL + Y para interver
    </div>
  </body>

  <script is:inline src="https://unpkg.com/lucide@latest"></script>
  <script is:inline>
    const updateScrollTime = (velocity) => {
      scrollTime = velocity;
    };

    let scrolling;
    let scrollTime = 15;
    let direction = 1; // 1 for forward, -1 for reverse

    function startScroll() {
      window.scrollBy(0, 1 * direction);
      scrolling = setTimeout(startScroll, scrollTime);
    }

    function stopScroll() {
      clearTimeout(scrolling);
      scrolling = undefined;
    }

    let keys = {};
    window.addEventListener("keyup", () => {
      keys = {};
    });

    window.addEventListener("keydown", (e) => {
      keys[e.key] = true;

      if (keys["Control"] && keys["y"]) {
        invertText();
      } else if (keys["Control"] && keys["l"]) {
        togglePlay();
      } else if (keys["Control"] && keys["j"]) {
        decreaseSpeed();
      } else if (keys["Control"] && keys["k"]) {
        increaseSpeed();
      } else if (keys["Control"] && keys[";"]) {
        toggleDirection();
      }
    });

    const setActive = (selector, active) => {
      const btn = document.querySelector(`[${selector}]`);
      if (!btn) return;
      if (active) {
        btn.style.backgroundColor = "#a3e635";
        btn.style.color = "#000";
      } else {
        btn.style.backgroundColor = "";
        btn.style.color = "";
      }
    };

    function togglePlay() {
      if (scrolling) {
        stopScroll();
        setActive("data-toggle-play", false);
      } else {
        startScroll();
        setActive("data-toggle-play", true);
      }
    }

    const increaseSpeed = () => {
      updateScrollTime(scrollTime - 1);
      if (scrollTime < 0) {
        scrollTime = 0;
      }
    };

    const decreaseSpeed = () => {
      updateScrollTime(scrollTime + 1);
    };

    const toggleDirection = () => {
      direction *= -1;
      setActive("data-reverse", direction === -1);
    };

    const invertText = () => {
      document.getElementById("tp")?.classList.toggle("reversed");
      const isReversed = document.getElementById("tp")?.classList.contains("reversed");
      setActive("data-invert", isReversed);
    };

    const toggleTheme = () => {
      document.body.classList.toggle("dark");
      setActive("data-toggle-theme", document.body.classList.contains("dark"));
    };

    const toggleLock = () => {
      const tp = document.getElementById("tp");
      if (!tp) return;
      const locked = tp.getAttribute("contenteditable") === "false";
      tp.setAttribute("contenteditable", locked ? "true" : "false");
      setActive("data-lock-toggle", !locked);
      const btn = document.querySelector("[data-lock-toggle] i");
      if (btn) {
        btn.setAttribute("data-lucide", locked ? "lock-open" : "lock");
        lucide.createIcons();
      }
    };

    const clicks = {
      "data-speed-up": increaseSpeed,
      "data-slow-down": decreaseSpeed,
      "data-toggle-play": togglePlay,
      "data-reverse": toggleDirection,
      "data-invert": invertText,
      "data-lock-toggle": toggleLock,
      "data-toggle-theme": toggleTheme,
    };

    Object.keys(clicks).forEach((data) => {
      const currentFunction = clicks[data];
      document
        .querySelector(`[${data}]`)
        ?.addEventListener("click", currentFunction);
    });

    lucide.createIcons();
  </script>
</html>
